{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": { "allow": ["Read", "Edit", "Write", "Grep", "Glob"] },
  "model": "opus",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": { "effortLevel": "medium" },
    "claude-sonnet-5": { "effortLevel": "low" }
  },
  "statusLine": { "type": "command", "command": "ccstatusline" },
  "autoCompactEnabled": true,
  "autoCompactWindow": 250000,
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipDangerousModePermissionPrompt": false,
  "extraKnownMarketplaces": {
    "claude-community": { "source": { "source": "github", "repo": "anthropics/claude-plugins-community" } },
    "ponytail": { "source": { "source": "github", "repo": "DietrichGebert/ponytail" } }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "ponytail@ponytail": false
  }
}
